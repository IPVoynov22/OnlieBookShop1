@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0" style="background-color: #EFECE6; border-radius: 12px;">
            <div class="card-body p-4">
                <h2 class="text-center mb-4 serif-text" style="color: #2B2B2B;">Login</h2>
                
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                    <div class="form-group mb-3">
                        <label name="email" class="form-label fw-bold">Email</label>
                        <input name="email" type="email" class="form-control" placeholder="name@example.com" required />
                    </div>

                    <div class="form-group mb-4">
                        <label name="password" class="form-label fw-bold">Password</label>
                        <input name="password" type="password" class="form-control" placeholder="Enter password" required />
                    </div>

                    <div class="form-group d-grid">
                        <button type="submit" class="btn text-white py-2 fw-semibold" style="background-color: #1B3B2B; border-color: #1B3B2B; border-radius: 8px;">Login</button>
                    </div>

                    <div class="mt-3 text-center">
                        <p class="text-muted mb-0">Don't have an account? <a asp-action="Register" class="text-decoration-none fw-bold" style="color: #1B3B2B;">Register here</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>