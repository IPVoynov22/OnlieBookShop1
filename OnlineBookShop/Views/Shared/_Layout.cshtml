<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ivelin.georgi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
   
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
   
    <div class="announcement-bar">
        Free shipping on orders over $40
    </div>


    <header>
        <nav class="navbar navbar-expand-lg py-3">
            <div class="container">
             
                <a class="navbar-brand-ig d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge">ig</span> ivelin.georgi
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                   
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-ig" asp-controller="Books" asp-action="Index">All books</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-ig" asp-controller="Books" asp-action="Index" asp-route-category="Fiction">Fiction</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-ig" asp-controller="Books" asp-action="Index" asp-route-category="Wellness">Wellness</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-ig" asp-controller="Books" asp-action="Index" asp-route-category="Nature">Nature</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-ig" asp-controller="Books" asp-action="Index" asp-route-category="Essays">Essays</a>
                        </li>
                    </ul>

                    
                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <span class="small text-muted me-2">Hello, @User.Identity.Name</span>
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="btn btn-sm btn-outline-dark" asp-controller="Categories" asp-action="Index">Admin Panel</a>
                            }
                            <a class="text-dark fs-5" asp-controller="Account" asp-action="Logout" title="Изход">
                                <i class="bi bi-box-arrow-right"></i>
                            </a>
                        }
                        else
                        {
                            <a class="text-dark fs-5" asp-controller="Account" asp-action="Login" title="Вход">
                                <i class="bi bi-person"></i>
                            </a>
                        }

                        <a class="text-dark fs-5 position-relative" asp-controller="Orders" asp-action="Cart" title="Количка">
                            <i class="bi bi-bag"></i>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    
    <div class="container my-4">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

   
    <footer class="border-top text-muted py-4 mt-auto">
        <div class="container text-center text-md-start d-flex justify-content-between align-items-center">
            <div>
                &copy; @DateTime.Now.Year - <strong>ivelin.georgi</strong> Independent Booksellers
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>