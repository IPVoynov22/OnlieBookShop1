@{
    ViewData["Title"] = "Home Page";
}


<div class="row align-items-center g-0 hero-card shadow-sm my-4 mx-2" style="background-color: #EFECE6; border-radius: 24px; overflow: hidden; border: 1px solid rgba(0,0,0,0.03);">
    
  
    <div class="col-lg-6 p-5 p-lg-5">
        <span class="text-uppercase fw-bold small tracking-wide d-block mb-2" style="letter-spacing: 2px; color: #B86B4D; font-size: 0.75rem;">
            CURATED COLLECTION
        </span>
        <h1 class="display-4 serif-text fw-normal mb-3" style="color: #1B3B2B; line-height: 1.15;">
            Good books, <br />
            <span style="font-style: italic; color: #B86B4D;">chosen with care.</span>
        </h1>
        <p class="mb-4 fs-6" style="color: #666; max-width: 420px; line-height: 1.6;">
            A small, thoughtful collection of stories and ideas worth making time for.
        </p>
        <a asp-controller="Books" asp-action="Index" class="btn text-white px-4 py-3 text-decoration-none fw-medium shadow-sm" style="background-color: #1B3B2B; border-radius: 12px; transition: all 0.3s ease;">
            Browse books &rarr;
        </a>
    </div>

   
    <div class="col-lg-6 p-3 p-lg-4 d-flex align-items-center justify-content-center">
        <div class="w-100 h-100 overflow-hidden shadow-sm" style="border-radius: 18px; max-height: 420px;">
            <img src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?auto=format&fit=crop&w=1000&q=80" 
                 alt="Bookstore interior" 
                 class="img-fluid w-100 h-100 object-fit-cover" 
                 style="min-height: 360px; transition: transform 0.5s ease;"
                 onmouseover="this.style.transform='scale(1.03)';" 
                 onmouseout="this.style.transform='scale(1.0)';" />
        </div>
    </div>
</div>

<!-- Секция за популярни книги -->
<div class="mt-5 pt-3 px-2">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <span class="text-uppercase fw-bold small tracking-wide d-block mb-1" style="letter-spacing: 1.5px; color: #B86B4D; font-size: 0.75rem;">
                OUR SELECTION
            </span>
            <h2 class="serif-text mb-0" style="color: #1B3B2B; font-size: 2rem;">Popular books</h2>
        </div>
        <a asp-controller="Books" asp-action="Index" class="text-decoration-none fw-bold small text-hover-underline" style="color: #1B3B2B;">
            View all books &rarr;
        </a>
    </div>
</div>