@model OnlineBookShop.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="hero-card shadow-sm border-0 p-4 p-md-5" style="background-color: var(--card-bg); border-radius: 16px;">
            
            <!-- Заглавна секция -->
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <span class="text-uppercase small tracking-wider" style="color: var(--terracotta); font-weight: 600;">Book Overview</span>
                    <h2 class="serif-text display-6 mt-1" style="color: var(--forest-green);">@Model.Title</h2>
                </div>
                <span class="badge px-3 py-2" style="background-color: var(--forest-green); color: #ffffff; font-weight: 500; font-size: 0.85rem; border-radius: 8px;">
                    In Stock: @Model.StockQuantity
                </span>
            </div>

            <hr style="border-color: #DED8CC;" class="mb-4">

            <!-- Списък с детайли -->
            <div class="row g-4 mb-4">
                <div class="col-sm-6">
                    <span class="d-block small text-muted mb-1">Author</span>
                    <strong class="fs-5" style="color: var(--text-dark);">@Model.Author</strong>
                </div>
                <div class="col-sm-6">
                    <span class="d-block small text-muted mb-1">Price</span>
                    <strong class="fs-5" style="color: var(--terracotta); font-weight: 700;">$@Model.Price</strong>
                </div>
                <div class="col-sm-6">
                    <span class="d-block small text-muted mb-1">Category</span>
                    <span class="badge px-3 py-2" style="background-color: #ffffff; color: var(--text-dark); border: 1px solid #DED8CC; border-radius: 6px;">
                        @(Model.Category != null ? Model.Category.CategoryName : Model.CategoryId.ToString())
                    </span>
                </div>
            </div>

            <!-- Долна лента с бутони -->
            <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top" style="border-color: #DED8CC !important;">
                <a asp-action="Index" class="text-decoration-none fw-medium" style="color: var(--forest-green);">
                    ← Back to Books
                </a>
                
                <div>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model?.BookId" class="btn-forest" style="padding: 8px 20px; text-decoration: none;">
                            Edit Book
                        </a>
                    }
                </div>
            </div>

        </div>
    </div>
</div>