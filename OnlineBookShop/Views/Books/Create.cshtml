@model OnlineBookShop.Models.Book

@{
    ViewData["Title"] = "Add New Book";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="hero-card shadow-sm border-0 p-4 p-md-5" style="background-color: var(--card-bg); border-radius: 16px;">
            
            <div class="mb-4">
                <span class="text-uppercase small tracking-wider" style="color: var(--terracotta); font-weight: 600;">Admin Panel</span>
                <h2 class="serif-text display-6 mt-1" style="color: var(--forest-green);">Add New Book</h2>
                <p class="text-muted mt-2">Fill in the details below to add a new book to the catalog.</p>
            </div>

            <hr style="border-color: #DED8CC;" class="mb-4">

            <form asp-action="Create">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-medium" style="color: var(--text-dark);"></label>
                    <input asp-for="Title" class="form-control" placeholder="Enter book title" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Author" class="form-label fw-medium" style="color: var(--text-dark);"></label>
                    <input asp-for="Author" class="form-control" placeholder="Enter author name" />
                    <span asp-validation-for="Author" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label fw-medium" style="color: var(--text-dark);"></label>
                    <input asp-for="Price" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StockQuantity" class="form-label fw-medium" style="color: var(--text-dark);"></label>
                    <input asp-for="StockQuantity" class="form-control" placeholder="0" />
                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="CategoryId" class="form-label fw-medium" style="color: var(--text-dark);">Category</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top" style="border-color: #DED8CC !important;">
                    <a asp-action="Index" class="text-decoration-none fw-medium" style="color: var(--forest-green);">
                        ← Back to List
                    </a>
                    <input type="submit" value="Create Book" class="btn-forest" style="cursor: pointer; border: none; padding: 10px 24px; border-radius: 8px;" />
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Предотвратява проблеми с десетични знаци (заменя запетая с точка автоматично при изпращане)
        document.querySelector('form').addEventListener('submit', function () {
            const priceInput = document.querySelector('input[name="Price"]');
            if (priceInput && priceInput.value.includes(',')) {
                priceInput.value = priceInput.value.replace(',', '.');
            }
        });
    </script>
}