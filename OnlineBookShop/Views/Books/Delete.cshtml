@model OnlineBookShop.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="hero-card shadow-sm border-0 p-4 p-md-5" style="background-color: var(--card-bg); border-radius: 16px;">
            
            <div class="mb-4">
                <span class="text-uppercase small tracking-wider" style="color: var(--terracotta); font-weight: 600;">Warning</span>
                <h2 class="serif-text display-6 mt-1" style="color: var(--forest-green);">Delete Book</h2>
                <p class="text-muted mt-2">Are you sure you want to delete this book from the catalog?</p>
            </div>

            <hr style="border-color: #DED8CC;" class="mb-4">

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <span class="d-block small text-muted">Title</span>
                    <strong class="fs-6" style="color: var(--text-dark);">@Model.Title</strong>
                </div>
                <div class="col-sm-6">
                    <span class="d-block small text-muted">Author</span>
                    <strong class="fs-6" style="color: var(--text-dark);">@Model.Author</strong>
                </div>
                <div class="col-sm-6">
                    <span class="d-block small text-muted">Price</span>
                    <strong class="fs-6" style="color: var(--terracotta);">$@Model.Price</strong>
                </div>
                <div class="col-sm-6">
                    <span class="d-block small text-muted">Stock Quantity</span>
                    <strong class="fs-6" style="color: var(--text-dark);">@Model.StockQuantity</strong>
                </div>
                <div class="col-sm-6">
                    <span class="d-block small text-muted">Category</span>
                    <strong class="fs-6" style="color: var(--text-dark);">@(Model.Category?.CategoryName ?? "-")</strong>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="BookId" />
                
                <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top" style="border-color: #DED8CC !important;">
                    <a asp-action="Index" class="text-decoration-none fw-medium" style="color: var(--forest-green);">
                        ← Back to List
                    </a>
                    <input type="submit" value="Confirm Delete" class="btn" style="background-color: var(--terracotta); color: white; border-radius: 8px; padding: 10px 20px; font-weight: 500; border: none;" />
                </div>
            </form>

        </div>
    </div>
</div>