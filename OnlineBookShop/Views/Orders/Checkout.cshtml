@model OnlineBookShop.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="container mt-4">
    <h2>Checkout</h2>

    <form asp-action="Checkout" method="post" class="mt-4">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6">
                <h4>Customer Information</h4>
                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label">First Name</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="LastName" class="form-label">Last Name</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Phone" class="form-label">Phone</label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <h4 class="mt-4">Payment Details (Simulation)</h4>
                <div class="mb-3">
                    <label asp-for="CardHolderName" class="form-label">Cardholder Name</label>
                    <input asp-for="CardHolderName" class="form-control" placeholder="John Doe" />
                    <span asp-validation-for="CardHolderName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="CardNumber" class="form-label">Card Number</label>
                    <input asp-for="CardNumber" class="form-control" placeholder="1234-5678-9012-3456" />
                    <span asp-validation-for="CardNumber" class="text-danger"></span>
                </div>

                <!-- Нови полета за Expiry Date и CVC -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ExpiryDate" class="form-label">Expiry Date</label>
                        <input asp-for="ExpiryDate" class="form-control" placeholder="MM/YY" />
                        <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Cvc" class="form-label">CVC / CVV</label>
                        <input asp-for="Cvc" class="form-control" placeholder="123" type="password" maxlength="4" />
                        <span asp-validation-for="Cvc" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <h4>Order Summary</h4>
                <ul class="list-group mb-3">
                    @foreach (var item in Model.CartItems)
                    {
                        <li class="list-group-item d-flex justify-content-between lh-sm">
                            <div>
                                <h6 class="my-0">@item.Title</h6>
                                <small class="text-muted">Quantity: @item.Quantity</small>
                            </div>
                            <span class="text-muted">$@item.TotalPrice.ToString("F2")</span>
                        </li>
                    }
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Total (USD)</span>
                        <strong>$@Model.GrandTotal.ToString("F2")</strong>
                    </li>
                </ul>

                <button type="submit" class="btn btn-primary w-100 btn-lg">Place Order</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}