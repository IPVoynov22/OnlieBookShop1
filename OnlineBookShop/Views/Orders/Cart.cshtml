@model List<OnlineBookShop.Models.CartItemViewModel>

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-5 mb-5">
    <!-- Заглавие на страницата -->
    <div class="mb-4">
        <span class="text-uppercase small tracking-wider" style="color: var(--terracotta); font-weight: 600;">Your Bag</span>
        <h2 class="serif-text display-6 mt-1" style="color: var(--forest-green);">Shopping Cart</h2>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm border-0" style="border-radius: 12px;">@TempData["Error"]</div>
    }

    @if (Model == null || !Model.Any())
    {
       
        <div class="hero-card shadow-sm border-0 text-center py-5 px-4 mt-3" style="background-color: var(--card-bg, #fdfbf7); border-radius: 16px;">
            <div class="mb-3">
                <div class="d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 80px; height: 80px; background-color: #e3ede6; border-radius: 50%; color: var(--forest-green); font-size: 32px;">
                    <i class="bi bi-bag"></i>
                </div>
            </div>
            <h4 class="serif-text mb-2" style="color: var(--forest-green);">Your cart is empty</h4>
            <p class="text-muted mb-4" style="max-width: 400px; margin: 0 auto;">Looks like you haven't added any books to your cart yet. Explore our catalog and find your next great read.</p>
            <a asp-controller="Books" asp-action="Index" class="btn text-white px-4 py-2 shadow-sm" style="background-color: var(--forest-green); border-radius: 8px; font-weight: 500;">
                Explore Books
            </a>
        </div>
    }
    else
    {
        <!-- АКО ИМА ПРОДУКТИ В КОЛИЧКАТА -->
        <div class="hero-card shadow-sm border-0 p-4" style="background-color: var(--card-bg, #fdfbf7); border-radius: 16px;">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr style="border-color: #DED8CC; color: var(--forest-green);">
                            <th class="py-3">Book Title</th>
                            <th class="py-3">Price</th>
                            <th class="py-3">Quantity</th>
                            <th class="py-3">Total</th>
                            <th class="py-3 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr style="border-color: #DED8CC;">
                                <td class="py-3 fw-medium" style="color: var(--text-dark);">@item.Title</td>
                                <td class="py-3" style="color: var(--terracotta);">$@item.Price.ToString("F2")</td>
                                <td class="py-3">@item.Quantity</td>
                                <td class="py-3 fw-bold" style="color: var(--forest-green);">$@item.TotalPrice.ToString("F2")</td>
                                <td class="py-3 text-end">
                                    <a asp-action="RemoveFromCart" asp-route-bookId="@item.BookId" class="btn btn-sm px-3" style="background-color: #fae1dd; color: var(--terracotta); border-radius: 6px;">Remove</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top" style="border-color: #DED8CC !important;">
                <h4 class="serif-text mb-0" style="color: var(--forest-green);">Grand Total: <span style="color: var(--terracotta);">$@Model.Sum(i => i.TotalPrice).ToString("F2")</span></h4>
                <div class="d-flex gap-2">
                    <a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 8px;">Continue Shopping</a>
                    <a asp-action="Checkout" class="btn text-white px-4 py-2 shadow-sm" style="background-color: var(--forest-green); border-radius: 8px; font-weight: 500;">Proceed to Checkout</a>
                </div>
            </div>
        </div>
    }
</div>