@model OnlineBookShop.Models.Category

@{
    ViewData["Title"] = "Add New Category";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="hero-card shadow-sm border-0 p-4 p-md-5" style="background-color: var(--card-bg); border-radius: 16px;">
            
            <div class="mb-4">
                <span class="text-uppercase small tracking-wider" style="color: var(--terracotta); font-weight: 600;">Admin Panel</span>
                <h2 class="serif-text display-6 mt-1" style="color: var(--forest-green);">Add New Category</h2>
                <p class="text-muted mt-2">Fill in the details below to add a new book category.</p>
            </div>

            <hr style="border-color: #DED8CC;" class="mb-4">

            <form asp-action="Create">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="CategoryName" class="form-label fw-medium" style="color: var(--text-dark);">Category Name</label>
                    <input asp-for="CategoryName" class="form-control" placeholder="Enter category name" />
                    <span asp-validation-for="CategoryName" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top" style="border-color: #DED8CC !important;">
                    <a asp-action="Index" class="text-decoration-none fw-medium" style="color: var(--forest-green);">
                        ← Back to List
                    </a>
                    <input type="submit" value="Create Category" class="btn-forest" style="cursor: pointer; border: none; padding: 10px 24px; border-radius: 8px;" />
                </div>
            </form>

        </div>
    </div>
</div>